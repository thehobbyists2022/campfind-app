// ============================================================================
// Camp Finder — 完整資料庫 Schema (Prisma)
// ============================================================================
// 基於 open source bozeman-camp-finder 改良，加上：
//   - PostGIS 地理查詢 (30 miles 範圍搜尋)
//   - Real-time availability 庫存追蹤
//   - 多 session / 多價格 / 早鳥優惠
//   - 評價與評分系統
//   - 多孩子管理 + 行事曆排程
//   - 爬蟲 metadata 追蹤
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // 需安裝 PostGIS extension:
  // CREATE EXTENSION IF NOT EXISTS postgis;
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CampCategory {
  SPORTS
  ARTS
  STEM
  OUTDOOR
  MUSIC
  ACADEMIC
  THEATER
  COOKING
  LANGUAGE
  GENERAL
}

enum CampType {
  DAY
  OVERNIGHT
  BOTH
  FAMILY
  ADULT
}

enum ScheduleType {
  FULL_DAY
  MORNING
  AFTERNOON
  FULL_WEEK
  MULTI_WEEK
}

enum SessionStatus {
  OPEN
  ALMOST_FULL
  WAITLIST
  FULL
  CANCELLED
}

enum DataSource {
  ACA          // American Camp Association
  MANUAL       // Manually entered by provider
  SCRAPED      // Web-scraped from camp website
  PARTNER_API  // Partner API (CampMinder, Bunk1, etc.)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Auth — Users (Parents)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  authProvider  String?   // "google", "apple", "email"
  authId        String?   // OAuth provider's user ID

  // Preferences
  defaultZip     String?
  defaultRadius  Int?       @default(30)  // miles
  language       String?    @default("en") // "en", "zh-TW", "es", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions AuthSession[]
  children Child[]
  plans    Plan[]
  reviews  Review[]
  favorites Favorite[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Camp Provider (Organization running camps)
// ---------------------------------------------------------------------------

model Provider {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  website     String?
  phone       String?
  email       String?
  logoUrl     String?
  acaMember   Boolean    @default(false)  // ACA accredited?
  acaId       String?                      // ACA member ID

  // Social / contact
  facebookUrl  String?
  instagramUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  camps Camp[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Camp (the program / activity)
// ---------------------------------------------------------------------------

model Camp {
  id          String      @id @default(cuid())
  providerId  String
  name        String
  slug        String      @unique
  description String      @db.Text
  shortDesc   String?     @db.VarChar(300)

  category    CampCategory
  campType    CampType     @default(DAY)
  scheduleType ScheduleType @default(FULL_DAY)

  // Location
  address     String?
  city        String
  state       String      @default("CA")
  zipCode     String?
  // PostGIS地理座標 — 用於30 miles範圍查詢
  latitude    Float?
  longitude   Float?
  // loc 是 PostGIS geography point — 用原生 SQL 做 ST_DWithin 查詢
  // 需在 migration 中手動加: SELECT AddGeometryColumn('Camp', 'loc', 4326, 'POINT', 2);

  // Age range
  ageMin      Int
  ageMax      Int

  // Media
  imageUrl    String?
  galleryUrls String[]    @default([])

  // Registration
  registrationUrl String?
  contactEmail    String?
  contactPhone    String?

  // Categorization
  tags        String[]    @default([])
  featured    Boolean     @default(false)

  // Data source tracking
  dataSource  DataSource  @default(ACA)
  sourceUrl   String?     // Original source URL (e.g. ACA camp detail page)
  lastScraped DateTime?   // When our scraper last checked this camp
  sourceId    String?     // ID in the source system (e.g. ACA camp_id)

  // Before/after care availability
  hasBeforeCare  Boolean  @default(false)
  hasAfterCare   Boolean  @default(false)
  beforeCareTime String?  // e.g. "7:30 AM"
  afterCareTime  String?  // e.g. "6:00 PM"

  // Dietary / special needs
  dietaryInfo     String?  @db.Text
  specialNeedsInfo String? @db.Text

  // Pricing summary (lowest/highest session price for quick display)
  minPrice Float?
  maxPrice Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sessions  Session[]
  reviews   Review[]
  favorites Favorite[]

  @@index([providerId])
  @@index([category])
  @@index([city, state])
  @@index([zipCode])
  @@index([latitude, longitude])
  @@index([ageMin, ageMax])
  @@index([dataSource])
}

// ---------------------------------------------------------------------------
// Session (specific date range + pricing)
// ---------------------------------------------------------------------------

model Session {
  id          String        @id @default(cuid())
  campId      String
  name        String?       // e.g. "Session 1: Wildlife Explorers"

  startDate   DateTime
  endDate     DateTime
  startTime   String?       // e.g. "9:00 AM"
  endTime     String?       // e.g. "3:00 PM"
  daysOfWeek  Int[]         @default([1, 2, 3, 4, 5])  // 0=Sun, 1=Mon...

  // Pricing
  price           Float
  earlyBirdPrice  Float?
  earlyBirdDeadline DateTime?
  weeklyRate      Float?
  depositAmount   Float?
  materialsFee    Float?
  materialsIncluded Boolean @default(true)

  // Availability — real-time
  capacity   Int?
  enrolled   Int      @default(0)
  waitlistCount Int?  @default(0)
  status     SessionStatus @default(OPEN)

  // Extended care pricing
  beforeCarePrice Float?
  afterCarePrice  Float?

  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  camp      Camp       @relation(fields: [campId], references: [id], onDelete: Cascade)
  planItems PlanItem[]

  @@index([campId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// Child (linked to parent account)
// ---------------------------------------------------------------------------

model Child {
  id        String         @id @default(cuid())
  userId    String
  name      String
  birthDate DateTime
  grade     String?        // e.g. "1st", "2nd"
  interests CampCategory[]
  notes     String?        @db.Text  // allergies, special needs, etc.
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planItems PlanItem[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plan (a family's summer plan)
// ---------------------------------------------------------------------------

model Plan {
  id         String   @id @default(cuid())
  userId     String
  name       String   @default("Summer 2026")
  season     String?  // e.g. "2026"
  budget     Float?
  shareToken String?  @unique  // for sharing with family/friends
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlanItem[]

  @@index([userId])
  @@index([shareToken])
}

// ---------------------------------------------------------------------------
// PlanItem (a session added to a plan, linked to a child)
// ---------------------------------------------------------------------------

model PlanItem {
  id        String   @id @default(cuid())
  planId    String
  sessionId String
  childId   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@unique([planId, sessionId, childId])
  @@index([planId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Favorite (saved/bookmarked camps)
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  campId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([userId, campId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Review (parent review of a camp)
// ---------------------------------------------------------------------------

model Review {
  id        String       @id @default(cuid())
  campId    String
  userId    String
  rating    Int                       // 1-5
  title     String?      @db.VarChar(200)
  body      String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campId, userId])
  @@index([campId])
  @@index([rating])
}

// ---------------------------------------------------------------------------
// ScrapeLog — tracking what our crawler has done
// ---------------------------------------------------------------------------

model ScrapeLog {
  id          String   @id @default(cuid())
  dataSource  DataSource
  sourceUrl   String?
  itemsFound  Int
  itemsNew    Int
  itemsUpdated Int
  itemsFailed Int
  durationMs  Int
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([dataSource])
  @@index([createdAt])
}

// ============================================================================
// PostGIS queries (for reference — not valid Prisma syntax)
// ============================================================================
//
// -- Find camps within 30 miles of a ZIP code
// -- First, geocode the ZIP to lat/lng (using geocoding service)
// -- Then:
//
// SELECT c.* FROM "Camp" c
// WHERE ST_DWithin(
//   c.loc::geography,
//   ST_SetSRID(ST_MakePoint(-117.1611, 32.7157), 4326)::geography,
//   48280  -- 30 miles in meters
// )
// AND c.age_min <= 12 AND c.age_max >= 5
// ORDER BY c.min_price ASC;
//
// ============================================================================
// 30 miles = 48,280 meters (1 mile ≈ 1,609.34 meters)
// ============================================================================
