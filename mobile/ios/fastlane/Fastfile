default_platform(:ios)

platform :ios do
  desc "Build and upload to App Store Connect using existing cert & profile from secrets"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    sh "flutter pub get"
    sh "flutter build ios --release --no-codesign"

    profile = Dir[File.expand_path("~/Library/MobileDevice/Provisioning Profiles/*.mobileprovision")].sort.last
    raise "Provisioning profile not found" unless profile

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.campfind.app" => profile
        }
      }
    )

    ipa = Dir["build/ios/ipa/*.ipa"].first || Dir["*.ipa"].first
    raise "IPA not found" unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
