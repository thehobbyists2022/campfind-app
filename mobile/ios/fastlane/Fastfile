default_platform(:ios)

platform :ios do
  desc "Build and deploy to App Store Connect (fastlane match, reuses signing cert)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.campfind.app",
      readonly: false,
      git_url: "https://github.com/thehobbyists2022/campfind-app.git",
      git_branch: "certificates",
      keychain_name: "ci_keychain",
      keychain_password: "ci_password",
      force_for_new_devices: false
    )

    # Pre-build the Flutter iOS frameworks so xcodebuild can find them
    sh "flutter pub get"
    sh "flutter build ios --release --no-codesign"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.campfind.app" => lane_context[SharedValues::SIGH_PROFILE_PATH]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
