default_platform(:ios)

platform :ios do
  desc "Build and deploy to App Store Connect via fastlane match (auto-managed cert)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Sync the active API-key distribution cert (1006FD15) from Apple into the
    # dedicated 'campfind' branch of the signing repo. Reuses the existing cert
    # (no new cert, no cap hit), and leaves TaiwanBite's TONY KUO cert untouched.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.campfind.app",
      readonly: false,
      git_url: "https://github.com/thehobbyists2022/campfind-signing.git",
      git_branch: "campfind",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
      keychain_name: "ci_keychain",
      keychain_password: "ci_password",
      force_for_new_devices: false
    )

    # Build unsigned first, then sign with the match-imported cert + profile via
    # manual signing. Use the exact profile name match generated (from lane_context)
    # so Xcode doesn't look for a stale hardcoded profile name.
    sh "flutter pub get"
    sh "flutter build ios --release --no-codesign"

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.campfind.app"]
    raise "match profile not found" unless profile_name

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: "VNTPT66236",
        provisioningProfiles: {
          "com.campfind.app" => profile_name
        }
      }
    )

    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH] || Dir["build/ios/ipa/*.ipa"].first
    raise "IPA not found" unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
