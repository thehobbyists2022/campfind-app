default_platform(:ios)

platform :ios do
  desc "Build and deploy to App Store Connect via fastlane match (auto-managed cert)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # readonly: false lets match sync the active distribution cert (1006FD15...) from
    # Apple via the API key into the signing repo. It reuses the existing valid cert
    # rather than creating a new one (so it does NOT hit the 2-cert cap and does not
    # revoke anything). The .p12 password is NOT needed — match gets the private key
    # directly from the App Store Connect API key.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.campfind.app",
      readonly: false,
      git_url: "https://github.com/thehobbyists2022/campfind-signing.git",
      git_branch: "certificates",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
      keychain_name: "ci_keychain",
      keychain_password: "ci_password",
      force_for_new_devices: false
    )

    sh "flutter pub get"
    # Automatic signing: Xcode picks up the match-imported distribution cert + profile
    # from the keychain. No --no-codesign (that breaks signatures).
    sh "flutter build ipa --release"

    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH] || Dir["build/ios/ipa/*.ipa"].first
    raise "IPA not found" unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
