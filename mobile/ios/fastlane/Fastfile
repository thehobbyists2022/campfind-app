default_platform(:ios)

platform :ios do
  desc "Build and deploy to TestFlight and App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    kc_path = File.expand_path("~/Library/Keychains/ci_keychain-db")

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    get_certificates(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: "ci_password"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.campfind.app"
    )

    # Unlock keychain for codesign toolchain
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k ci_password #{kc_path}")

    # Build iOS IPA using native Flutter CLI from mobile directory
    sh("cd .. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist")

    ipa_path = Dir[File.expand_path("../../build/ios/ipa/*.ipa")].first || Dir[File.expand_path("../build/ios/ipa/*.ipa")].first

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: ipa_path
    )
  end
end
