default_platform(:ios)

platform :ios do
  desc "Build and deploy to App Store Connect via fastlane match (reuses existing signing cert)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # match REUSES the existing distribution certificate + profile stored in the
    # signing git repo. Unlike `get_certificates`, it will NOT generate a new
    # certificate on every CI run, so it can never hit Apple's 2-cert limit.
    match(
      type: "app_store",
      api_key: api_key,
      app_identifier: "com.campfind.app",
      readonly: ENV["MATCH_READONLY"] == "true",
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: ENV["MATCH_GIT_BRANCH"] || "certificates",
      keychain_name: "ci_keychain",
      keychain_password: "ci_password"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: false,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.campfind.app" => lane_context[SharedValues::SIGH_PROFILE_PATH]
        }
      }
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end
end
